{
  "cleanupPeriodDays": 45,
  "env": {
    "BASH_DEFAULT_TIMEOUT_MS": "10000",
    "BASH_MAX_TIMEOUT_MS": "120000",
    "ENABLE_TOOL_SEARCH": "true"
  },
  "includeCoAuthoredBy": false,
  "permissions": {
    "allow": [],
    "deny": [
      "Bash(rm -rf ~)",
      "Bash(rm -fr ~)",
      "Bash(rm -rf ~/)",
      "Bash(rm -fr ~/)",
      "Bash(rm -rf $HOME)",
      "Bash(rm -fr $HOME)",
      "Bash(rm -rf $HOME/)",
      "Bash(rm -rf ${HOME})",
      "Bash(rm -rf ${HOME}/)",
      "Bash(rm -rf \"$HOME\")",
      "Bash(rm -rf \"$HOME/\")",
      "Bash(rm -rf /)",
      "Bash(rm -fr /)",
      "Bash(sudo *)",
      "Bash(chmod 777 *)",
      "Bash(mkfs *)",
      "Bash(dd *)",
      "Bash(git push --force *)",
      "Bash(git reset --hard *)"
    ],
    "ask": [],
    "defaultMode": "bypassPermissions"
  },
  "model": "opus",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/claude-guards bash",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "Read",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/claude-guards read",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "B=\"$HOME/.local/bin/memorylint\"; [ -x \"$B\" ] || exit 0; exec \"$B\" hook",
            "timeout": 10,
            "statusMessage": "Checking memory write for secrets…"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "B=\"$HOME/.local/bin/memorylint\"; [ -x \"$B\" ] || exit 0; exec \"$B\" hook",
            "timeout": 10,
            "statusMessage": "Validating memory note…"
          }
        ]
      }
    ]
  },
  "effortLevel": "high",
  "awaySummaryEnabled": false,
  "askUserQuestionTimeout": "never",
  "tui": "default",
  "skipDangerousModePermissionPrompt": true,
  "switchModelsOnFlag": true,
  "teammateMode": "tmux"
}
